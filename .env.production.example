# =====================================================================
# .env.production.example
# Salin menjadi .env.production, lalu isi nilainya.
# Cara termudah: jalankan scripts\windows\02-Siapkan-Config.ps1
# File .env.production TIDAK ikut terkirim ke GitHub (sudah di .gitignore).
# =====================================================================

APP_NAME="WebCraft Agency"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://ghani-jasa-secsion.sahir.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# stderr = log masuk ke "docker logs webcraft_app" (mudah dibaca di PowerShell)
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------------- Database (PostgreSQL di dalam Docker) --------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=webcraft_db
DB_USERNAME=webcraft_user
DB_PASSWORD=ganti-password-ini

# ---------------- Session & cache -----------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ---------------- Cloudflare Tunnel ---------------------------------
# Token dari Cloudflare Zero Trust > Networks > Tunnels > (tunnel) > Install connector
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------- Perilaku deploy -----------------------------------
# true  = isi data demo (5 akun, 4 paket, 1 order) setiap deploy.
#         Seeder memakai firstOrCreate, jadi aman diulang.
# false = jangan menyentuh data sama sekali.
SEED_ON_DEPLOY=true

# Nama image di GitHub Container Registry (dipakai saat -UseRegistry)
APP_IMAGE=ghcr.io/ghanisyifanur-analisis/ghani-jasa-secsion:latest

# ---------------- Payment gateway (sandbox) -------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-SampleMockKeyWebCraft2026
MIDTRANS_CLIENT_KEY=SB-Mid-client-SampleMockKeyWebCraft2026
MIDTRANS_IS_PRODUCTION=false

# ---------------- WhatsApp gateway ----------------------------------
FONNTE_TOKEN=MOCK_TOKEN_FONNTE_2026
WHATSAPP_ADMIN_PHONE=081288880001
